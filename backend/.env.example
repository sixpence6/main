# Copy to backend/.env and fill in the provider values for this machine.
# Operating system environment variables with the same names take precedence.
# Every value here is blank on purpose: an empty configuration still boots and
# serves diagnostics and history; only the corresponding model operations fail.

# Built-in language-model adapter: "openai-chat" speaks the OpenAI-compatible
# POST /chat/completions protocol and asks for a JSON object. It handles both
# clarifying questions (needs_input) and the final review (review). Set the base
# URL to the API root that ends in /v1; no per-machine code changes are needed.
# Example:
#   LLM_ADAPTER=openai-chat
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini
LLM_ADAPTER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional multimodal model for the same OpenAI-compatible /chat/completions
# protocol. When set, the project reference image is attached to the organizer
# request as a data URI; text-only requests still use LLM_MODEL. Leave blank to
# stay text-only. If the provider requires a different key or API root for the
# multimodal model, set LLM_VISION_BASE_URL and LLM_VISION_API_KEY; both fall
# back to LLM_BASE_URL and LLM_API_KEY when left blank.
#   LLM_VISION_MODEL=gpt-4o-mini
LLM_VISION_BASE_URL=
LLM_VISION_API_KEY=
LLM_VISION_MODEL=
LLM_TIMEOUT_SECONDS=3600
# Text requests only; auto omits the provider-specific thinking parameter.
# Use disabled only when the configured gateway/model supports this option.
LLM_THINKING_MODE=auto
# Reasoning effort is independent for text and reference-image analysis models.
# auto omits the parameter; supported explicit values: low, medium, high.
LLM_REASONING_EFFORT=auto
LLM_VISION_REASONING_EFFORT=auto

# Built-in visual adapter: "openai-images" speaks the OpenAI-compatible
# POST /images/generations and POST /images/edits protocols. It supports
# text-to-image and single-image reference generation at an exact configured
# size (for example 3840x2160). Set the base URL to the API root that ends in
# /v1; no per-machine code changes are needed.
# Example:
#   VISUAL_ADAPTER=openai-images
#   VISUAL_BASE_URL=https://api.openai.com/v1
#   VISUAL_MODEL=gpt-image-1
#   VISUAL_IMAGE_SIZE=3840x2160
VISUAL_ADAPTER=
VISUAL_BASE_URL=
VISUAL_API_KEY=
VISUAL_MODEL=
VISUAL_IMAGE_SIZE=
VISUAL_TASK_TIMEOUT_SECONDS=300

# Optional overrides (project-relative defaults are used when left unset)
# APP_DATA_DIR=./data
# DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# WEB_DIST_DIR=main/dist

# Current collaborative roles hand off original Markdown documents.
WORKFLOW_HANDOFF_FORMAT=markdown
