# Copy to backend/.env and fill in the provider values for this machine.
# Operating system environment variables with the same names take precedence.
# Every value here is blank on purpose: an empty configuration still boots and
# serves diagnostics and history; only the corresponding model operations fail.

# Built-in language-model adapter: "openai-chat" speaks the OpenAI-compatible
# POST /chat/completions protocol and asks for a JSON object. It handles both
# clarifying questions (needs_input) and the final review (review). Set the base
# URL to the API root that ends in /v1; no per-machine code changes are needed.
# Example:
#   LLM_ADAPTER=openai-chat
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini
LLM_ADAPTER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# Built-in visual adapter: "openai-images" speaks the OpenAI-compatible
# POST /images/generations and POST /images/edits protocols. It supports
# 1024x1024 text-to-image and single-image reference generation. Set the base
# URL to the API root that ends in /v1; no per-machine code changes are needed.
# Example:
#   VISUAL_ADAPTER=openai-images
#   VISUAL_BASE_URL=https://api.openai.com/v1
#   VISUAL_MODEL=gpt-image-1
#   VISUAL_IMAGE_SIZE=1024x1024
VISUAL_ADAPTER=
VISUAL_BASE_URL=
VISUAL_API_KEY=
VISUAL_MODEL=
VISUAL_IMAGE_SIZE=
VISUAL_TASK_TIMEOUT_SECONDS=300

# Optional overrides (project-relative defaults are used when left unset)
# APP_DATA_DIR=./data
# DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# WEB_DIST_DIR=main/dist
