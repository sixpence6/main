{
  "schema": 1,
  "package": "ecommerce-image-workspace",
  "source_root": "main",
  "version_source": "package.json",
  "include": [
    ".dockerignore",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "package.json",
    "package-lock.json",
    "tsconfig.json",
    "vite.config.ts",
    "index.html",
    "src/**",
    "docker-compose.yml",
    "docker/**",
    "backend/README.md",
    "backend/.env.example",
    "backend/alembic.ini",
    "backend/pyproject.toml",
    "backend/uv.lock",
    "backend/app/**",
    "backend/migrations/**",
    "dist/**"
  ],
  "required": [
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "package.json",
    "package-lock.json",
    "tsconfig.json",
    "vite.config.ts",
    "index.html",
    "src/main.ts",
    "docker-compose.yml",
    "docker/Dockerfile",
    "docker/backend.Dockerfile",
    "docker/nginx.conf.template",
    "backend/README.md",
    "backend/.env.example",
    "backend/alembic.ini",
    "backend/pyproject.toml",
    "backend/uv.lock",
    "backend/app/main.py",
    "backend/app/production.py",
    "backend/migrations/env.py"
  ],
  "forbidden_components": [
    "tests",
    "test",
    "__pycache__",
    ".pytest_cache",
    ".ruff_cache",
    ".venv",
    "node_modules",
    ".git",
    ".scratch"
  ],
  "forbidden_files": [
    ".env",
    "backend/.env"
  ],
  "forbidden_suffixes": [
    ".pyc",
    ".db",
    ".db-wal",
    ".db-shm",
    ".log"
  ],
  "generated": [
    "backend/data/.gitkeep",
    "RELEASE-MANIFEST.json",
    "SHA256SUMS"
  ],
  "build": {
    "command": "npm run build",
    "source_dir": "main",
    "dist_dir": "main/dist"
  }
}
