{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sixpence6.github.io/main/evidence-format-v1.json",
  "title": "v3 remediation evidence record v1",
  "description": "Shared machine-readable evidence record for every v3 remediation ticket. A pass requires current command/run evidence and counts; old documents, screenshots and green unit tests alone are not evidence.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "ticket",
    "code",
    "environment",
    "scope",
    "inputs",
    "commands",
    "candidate_budget",
    "calls",
    "acceptance",
    "slots",
    "results",
    "evidence",
    "residual_unknowns"
  ],
  "properties": {
    "ticket": {
      "type": "string",
      "pattern": "^#[0-9]+$"
    },
    "title": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "code": {
      "type": "object",
      "required": [
        "baseline_head",
        "branch",
        "app_code_head",
        "prompt_version",
        "rules_version",
        "rule_catalog_version"
      ],
      "properties": {
        "baseline_head": {
          "type": "string",
          "minLength": 7
        },
        "baseline_parent": {
          "type": "string"
        },
        "baseline_diff": {
          "type": "object",
          "properties": {
            "files": {
              "type": "integer",
              "minimum": 0
            },
            "insertions": {
              "type": "integer",
              "minimum": 0
            },
            "deletions": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "integration_head": {
          "type": "string"
        },
        "app_code_head": {
          "type": "string",
          "minLength": 7
        },
        "prompt_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "rules_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "rule_catalog_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "post_merge_rule_catalog_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "schema_version": {
          "type": "string"
        },
        "migration_head": {
          "type": "string"
        }
      }
    },
    "environment": {
      "type": "object",
      "required": [
        "type",
        "backend_python",
        "data_root",
        "network"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "e.g. isolated-temp-sqlite"
        },
        "backend_python": {
          "type": "string"
        },
        "data_root": {
          "type": "string",
          "description": "temp for isolated tests; never the real data root"
        },
        "network": {
          "type": "string",
          "description": "stubbed or the explicitly recorded real endpoint"
        },
        "database": {
          "type": "string"
        },
        "frontend": {
          "type": "string"
        },
        "os": {
          "type": "string"
        },
        "tool_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "normal, S12, history and/or baseline-record scopes"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "candidate_budget": {
      "type": "object",
      "required": [
        "artifact",
        "limit",
        "used",
        "reset_scope"
      ],
      "properties": {
        "artifact": {
          "type": "string"
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "used": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reset_scope": {
          "type": "string",
          "description": "whether the budget resets across recovery/history; explicit not-exercised when no attempt"
        }
      }
    },
    "calls": {
      "type": "object",
      "required": [
        "model_text",
        "model_vision",
        "image_generation"
      ],
      "properties": {
        "model_text": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "external text calls actually made; null if not instrumented"
        },
        "model_vision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "image_generation": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "note": {
          "type": "string"
        }
      }
    },
    "acceptance": {
      "type": "object",
      "description": "One entry per acceptance ID. Values may be a status string or an object with status/owner/basis. partial closes only the covered subcases and never makes the parent ticket pass.",
      "additionalProperties": {
        "oneOf": [
          {
            "enum": [
              "pass",
              "fail",
              "partial",
              "not-covered",
              "unknown"
            ]
          },
          {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "pass",
                  "fail",
                  "partial",
                  "not-covered",
                  "unknown"
                ]
              },
              "owner": {
                "type": "string"
              },
              "basis": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        ]
      },
      "propertyNames": {
        "pattern": "^(WG3|FE3)-AC-[0-9]{2}$"
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": true
    },
    "known_red_baseline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "test",
          "result",
          "owner"
        ],
        "additionalProperties": true
      }
    },
    "related_suite_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "acceptance_ids",
          "owner",
          "test"
        ],
        "additionalProperties": true
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": true
    },
    "review_consumers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage",
          "entrypoints",
          "required_rules",
          "duplicate_rule",
          "recovery",
          "history",
          "owner"
        ],
        "additionalProperties": true
      }
    },
    "reuse": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "record",
          "reusable",
          "not_reusable",
          "blocking_scope"
        ],
        "additionalProperties": true
      }
    },
    "slots": {
      "type": "object",
      "required": [
        "rolling_24h_accepted",
        "personal_active",
        "instance_concurrency"
      ],
      "properties": {
        "rolling_24h_accepted": {
          "type": [
            "integer",
            "null"
          ]
        },
        "personal_active": {
          "type": [
            "integer",
            "null"
          ]
        },
        "instance_concurrency": {
          "type": [
            "integer",
            "null"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "results": {
      "type": "object",
      "required": [
        "ui",
        "resources",
        "artifacts"
      ],
      "properties": {
        "ui": {
          "type": "string"
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "source_paths",
        "run_ids",
        "commands_output"
      ],
      "properties": {
        "source_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "run_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commands_output": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "residual_unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Explicit unknowns; an empty array is allowed only when every claimed pass has current evidence."
    }
  }
}
