# Frontend builds use the repository root; allow only their inputs.
*
!package.json
!package-lock.json
!main/
main/*
!main/package.json
!main/tsconfig.json
!main/vite.config.ts
!main/index.html
!main/src/
!main/src/**
!main/docker/
main/docker/*
!main/docker/Dockerfile
!main/docker/nginx.conf.template
!main/docker/nginx-tls.conf.template
!main/docker/security-headers.conf
!main/docker/hsts.conf

# Apply these exclusions after the allowlist, including within source trees.
**/.env
**/.env.*
**/.git
**/.venv
**/node_modules
**/__pycache__
**/tests
**/test
**/.scratch
**/.local
**/.config
**/data
**/backups
**/certs
**/*.pyc
**/*.db*
**/*.sqlite*
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.log
