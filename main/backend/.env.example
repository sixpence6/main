# Copy to backend/.env and fill in the provider values for this machine.
# Operating system environment variables with the same names take precedence.
# Every value here is blank on purpose: an empty configuration still boots and
# serves diagnostics and history; only the corresponding model operations fail.

# Built-in language-model adapter: "openai-chat" speaks the OpenAI-compatible
# POST /chat/completions protocol and asks for a JSON object. It handles both
# clarifying questions (needs_input) and the final review (review). Set the base
# URL to the API root that ends in /v1; no per-machine code changes are needed.
# Example:
#   LLM_ADAPTER=openai-chat
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini
LLM_ADAPTER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional multimodal model for the same OpenAI-compatible /chat/completions
# protocol. When set, the project reference image is attached to the organizer
# request as a data URI; text-only requests still use LLM_MODEL. Leave blank to
# stay text-only. If the provider requires a different key or API root for the
# multimodal model, set LLM_VISION_BASE_URL and LLM_VISION_API_KEY; both fall
# back to LLM_BASE_URL and LLM_API_KEY when left blank.
#   LLM_VISION_MODEL=gpt-4o-mini
LLM_VISION_BASE_URL=
LLM_VISION_API_KEY=
LLM_VISION_MODEL=
LLM_TIMEOUT_SECONDS=3600
# Text requests only; auto omits the provider-specific thinking parameter.
# Use disabled only when the configured gateway/model supports this option.
LLM_THINKING_MODE=auto
# Reasoning effort is independent for text and reference-image analysis models.
# auto omits the parameter; supported explicit values: low, medium, high.
LLM_REASONING_EFFORT=auto
LLM_VISION_REASONING_EFFORT=auto

# Built-in visual adapter: "openai-images" speaks the OpenAI-compatible
# POST /images/generations and POST /images/edits protocols. It supports
# text-to-image and single-image reference generation at an exact configured
# size (for example 3840x2160). Set the base URL to the API root that ends in
# /v1; no per-machine code changes are needed.
# Example:
#   VISUAL_ADAPTER=openai-images
#   VISUAL_BASE_URL=https://api.openai.com/v1
#   VISUAL_MODEL=gpt-image-1
#   VISUAL_IMAGE_SIZE=3840x2160
VISUAL_ADAPTER=
VISUAL_BASE_URL=
VISUAL_API_KEY=
VISUAL_MODEL=
VISUAL_IMAGE_SIZE=
VISUAL_TASK_TIMEOUT_SECONDS=300

# Current workflow: four roles, natural conversation, automatic generation and delivery.
# Historical policies are retained for old protocol verification only.
# WORKFLOW_ROLE_POLICY=collaborative
# WORKFLOW_GATE_MODE only applies to legacy/consolidated compatibility policies;
# it cannot enable content-review gates in the current collaborative workflow.
# WORKFLOW_GATE_MODE=off

# Optional overrides (project-relative defaults are used when left unset)
# APP_DATA_DIR=./data
# DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# WEB_DIST_DIR=main/dist

# Scheduled local backups. Leave APP_BACKUP_DIR unset to keep the background
# scheduler off; manual "python -m app.maintenance.cli backup" still works.
# The directory must be a restricted local path outside APP_DATA_DIR and
# WEB_DIST_DIR. It holds 7 independently verified snapshots plus status.json
# and latest.json; there is no web whole-database export route. Snapshot files
# never include .env, model keys or TLS private keys.
# APP_BACKUP_DIR=./backups
# APP_BACKUP_INTERVAL_SECONDS=86400
# APP_BACKUP_KEEP=7
# APP_BACKUP_TIMEOUT_SECONDS=60

# Browser-facing origin used when issuing account setup/reset links. Required for
# those links; the value must be an absolute http/https origin with no path.
# APP_PUBLIC_URL=http://127.0.0.1:8090

# Exact browser origins allowed for unsafe requests. A JSON array is required when
# set from the environment or an env file; do not use wildcards. For the Compose
# frontend on loopback HTTP this is ["http://127.0.0.1:8090"]. For HTTPS/LAN use
# the exact public origin including its port, for example
# ALLOWED_ORIGINS=["https://10.13.51.8:8443"]. HTTP origins are accepted only for
# loopback hosts.
# ALLOWED_ORIGINS=["http://127.0.0.1:8090"]

# Exact Host values accepted by the API. Add the LAN name or address used by the
# browser; never use "*". For HTTPS/LAN: ALLOWED_HOSTS=["10.13.51.8"]
# ALLOWED_HOSTS=["127.0.0.1","localhost","[::1]"]

# Trusted reverse proxies for X-Real-IP. Leave empty when the backend is reached
# directly. The Docker LAN overlay uses the Compose bridge subnet; never add
# 127.0.0.1 while the backend port is also published on loopback.
# TRUSTED_PROXY_CIDRS=["172.16.0.0/12"]

# Loopback-only HTTP development exception. Leave both unset for any LAN or
# production deployment; production must use HTTPS and secure cookies.
# ALLOW_LOOPBACK_HTTP=true
# AUTH_COOKIE_SECURE=false

# Current collaborative roles hand off original Markdown documents.
WORKFLOW_HANDOFF_FORMAT=markdown
